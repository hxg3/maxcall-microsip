<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CRM - Call Information</title>
<script src="https://cdn.tailwindcss.com"></script>
<script>
tailwind.config={theme:{extend:{colors:{teal:"#087B78","teal-dark":"#075B59","teal-light":"#0A9D98",gold:"#D6A62A","gold-soft":"#F4E7BF",surface:"#F8FAFA",white:"#FFFFFF","teal-soft":"#DDF2F0",ink:"#1F2929","ink-sec":"#3D4B4B",muted:"#718080",border:"#E7ECEC",success:"#218A67",error:"#C94A4A",warning:"#D49A24"}}}}
</script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
*{font-family:'Inter',system-ui,sans-serif}
body{background:#F8FAFA;margin:0;padding:0}
.fade-in{animation:fadeIn .3s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}
.pulse{animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
</style>
</head>
<body class="fade-in">

<!-- Header -->
<div class="bg-teal px-5 py-4">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-white font-bold text-lg">Incoming Call</h1>
      <p class="text-teal-soft text-xs mt-0.5" id="timestamp"></p>
    </div>
    <div class="w-10 h-10 rounded-xl bg-white/20 grid place-items-center">
      <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
      </svg>
    </div>
  </div>
</div>

<!-- Caller Info Card -->
<div class="mx-4 mt-4 bg-white rounded-2xl border border-border p-5">
  <div class="flex items-center gap-4 mb-4">
    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-teal to-teal-dark text-white grid place-items-center text-xl font-bold" id="avatar">?</div>
    <div class="flex-1 min-w-0">
      <div class="text-xl font-bold text-ink truncate" id="callerName">Loading...</div>
      <div class="text-sm text-muted mt-0.5 font-mono" id="callerNumber">-</div>
    </div>
  </div>
  <div class="flex items-center gap-2">
    <span class="px-3 py-1 rounded-full text-xs font-semibold" id="statusBadge">-</span>
    <span class="text-xs text-muted" id="callCount">-</span>
  </div>
</div>

<!-- Notes Section -->
<div class="mx-4 mt-4">
  <label class="text-sm font-semibold text-ink-sec block mb-2">Notes</label>
  <textarea id="notes" rows="5" placeholder="Add notes about this caller..."
    class="w-full px-4 py-3 border border-border rounded-xl text-sm text-ink bg-white focus:outline-none focus:ring-2 focus:ring-teal/20 focus:border-teal resize-none transition"></textarea>
</div>

<!-- Caller Name Input -->
<div class="mx-4 mt-3">
  <label class="text-sm font-semibold text-ink-sec block mb-2">Caller Name</label>
  <input type="text" id="callerNameInput" placeholder="Enter caller name"
    class="w-full px-4 py-3 border border-border rounded-xl text-sm text-ink bg-white focus:outline-none focus:ring-2 focus:ring-teal/20 focus:border-teal transition">
</div>

<!-- Buttons -->
<div class="mx-4 mt-5 flex gap-3">
  <button onclick="save()" class="flex-1 bg-teal hover:bg-teal-dark text-white font-semibold py-3 rounded-xl transition text-sm">
    Save
  </button>
  <button onclick="dismiss()" class="flex-1 bg-white border border-border text-ink-sec font-semibold py-3 rounded-xl hover:bg-surface transition text-sm">
    Dismiss
  </button>
  <button onclick="answer()" class="flex-1 bg-success hover:bg-success/90 text-white font-semibold py-3 rounded-xl transition text-sm">
    Answer
  </button>
</div>

<!-- Footer -->
<div class="mx-4 mt-4 mb-4 text-center">
  <p class="text-[11px] text-muted">Auto-dismiss in <span id="countdown">120</span>s</p>
</div>

<script>
let callerData = {number:'', name:'', notes:'', callId:-1};

function updateCallerInfo(number, name, notes, callId) {
  callerData = {number, name: name || 'Unknown', notes: notes || '', callId};
  document.getElementById('callerName').textContent = callerData.name;
  document.getElementById('callerNumber').textContent = callerData.number;
  document.getElementById('callerNameInput').value = callerData.name;
  document.getElementById('notes').value = callerData.notes;
  document.getElementById('avatar').textContent = callerData.name.charAt(0).toUpperCase();

  const badge = document.getElementById('statusBadge');
  if (callerData.name && callerData.name !== 'Unknown' && callerData.name !== 'New Caller') {
    badge.className = 'px-3 py-1 rounded-full text-xs font-semibold bg-teal-soft text-teal';
    badge.textContent = 'Registered';
  } else {
    badge.className = 'px-3 py-1 rounded-full text-xs font-semibold bg-gold-soft text-warning';
    badge.textContent = 'New Caller';
  }
}

function save() {
  const name = document.getElementById('callerNameInput').value.trim();
  const notes = document.getElementById('notes').value.trim();
  if (window.chrome && window.chrome.webview) {
    window.chrome.webview.postMessage(JSON.stringify({action:'save', name, notes}));
  }
}

function dismiss() {
  if (window.chrome && window.chrome.webview) {
    window.chrome.webview.postMessage(JSON.stringify({action:'dismiss'}));
  }
}

function answer() {
  if (window.chrome && window.chrome.webview) {
    window.chrome.webview.postMessage(JSON.stringify({action:'answer'}));
  }
}

// Update timestamp
function updateTimestamp() {
  const now = new Date();
  document.getElementById('timestamp').textContent = now.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
}
updateTimestamp();
setInterval(updateTimestamp, 1000);

// Countdown
let countdown = 120;
setInterval(() => {
  countdown--;
  if (countdown <= 0) countdown = 0;
  document.getElementById('countdown').textContent = countdown;
}, 1000);

// Initial demo data
updateCallerInfo('', 'New Caller', '', -1);
</script>

</body>
</html>
